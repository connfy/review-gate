# Publisher only. Copy outside the repository; never paste key contents here.
API_REVIEW_APP_ID=
API_REVIEW_INSTALLATION_ID=
API_REVIEW_PRIVATE_KEY_PATH=
# Confirm actual bot login and numeric USER id after App creation.
API_REVIEW_BOT_LOGIN=connfy-api-reviewer[bot]
API_REVIEW_BOT_ID=
# Installation scope is NOT runner authority. Exact repo names only; no globs.
API_REVIEW_ALLOWED_REPOS=connfy/aimstrings-docs,connfy/aimstrings-web
# If customized in the Worker, mirror these request-boundary settings here:
# REVIEW_REQUEST_TEXT=@codex review
# REVIEW_BOT_LOGINS=chatgpt-codex-connector,chatgpt-codex-connector[bot]
# Optional; if set, use exactly the same value in the Review Gate deployment.
# API_REVIEW_CLEAN_TEXT=API Credit Codex Review: No actionable P0–P2 findings.
# API_REVIEW_STATE_DIR=/home/minhun/.local/state/api-credit-reviewer
# CODEX_CREDIT_KEY_FILE=/home/minhun/.config/codex-credit/api-key
